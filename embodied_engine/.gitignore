# Runtime state, not source.
__pycache__/
*.pyc
.venv-download/
.venv-openwam/
records/*.pid
records/logs/
records/runs/
records/run_journal.jsonl
records/episode_mode.json
records/explore_summary.json

# Acceptance evidence (records/acceptance/*.json plus the archived
# <suite>_runs/ folders) is intentionally kept in version control: the report
# cites it and the engine prunes records/runs at runtime.

# Restored page log (runtime).
page_ui/logs/

# Raw per-episode engine dumps from the A/B benchmark (megabytes each). The
# report cites the slim summary, CSV, tables and failure evidence instead.
records/ab/*_runs/
.venv-d1/

# Offline evaluation stdout (runtime).
records/offline/*.log
