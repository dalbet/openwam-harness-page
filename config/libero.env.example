# Copy to config/libero.env to override this machine. Do not put real API keys here.
# The local vLLM planner accepts the dummy key EMPTY. Cloud credentials belong in
# openwam_harness/sequential/planner_profiles.local.json, which is gitignored.

# PLANNER_HOST=127.0.0.1
# PLANNER_PORT=8000
# PLANNER_CUDA_DEVICE=0
# PLANNER_MODEL=Qwen3.5-9B
# PLANNER_MODEL_PATH=/absolute/path/to/Qwen3.5-9B

# SEQUENTIAL_HOST=127.0.0.1
# SEQUENTIAL_PORT=8766
# SEQUENTIAL_CUDA_DEVICE=1
# HARNESS_LIVE=1

# PI05_CHECKPOINT_PATH=/absolute/path/to/RLinf-Pi05-LIBERO-130-fullshot-SFT
# SAM3_CHECKPOINT_PATH=/absolute/path/to/sam3.pt

# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=EMPTY
# SEQUENTIAL_DEBUG=0
# HF_HUB_OFFLINE=1
# MUJOCO_GL=egl
# LIBERO_TYPE=standard
